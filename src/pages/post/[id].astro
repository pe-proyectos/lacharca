---
import Layout from '../../layouts/Layout.astro'
import { hilos, timeAgo } from '../../lib/hilos'
import { getViewer } from '../../lib/session'
import PostActions from '../../components/PostActions'
import CommentThread from '../../components/CommentThread'
import Shell from '../../components/Shell.astro'

const id = Number(Astro.params.id)
if (!Number.isFinite(id)) return Astro.redirect('/')
const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const acting = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null

const post = await hilos(`/posts/${id}`, acting).catch(() => null)
if (!post) return Astro.redirect('/?post=no_encontrado')
const comments = (await hilos(`/posts/${id}/comments`, acting).catch(() => [])) || []

---
<Layout title={`${(post.content || 'Publicación').slice(0, 60)} — La Charca`}>
  <Shell viewer={viewer}>
  <div>
    <article class="pb-8 mb-6" style="border-bottom:1px solid var(--line)">
      <div class="flex items-center gap-2 mb-2">
        <a href={`/@${post.author?.handle}`} class="flex items-center gap-2 min-w-0">
          {post.author?.avatarUrl
            ? <img src={post.author.avatarUrl} alt="" class="w-10 h-10 rounded-xl object-cover" />
            : <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold ink-2">{(post.author?.displayName || post.author?.handle || '?')[0]?.toUpperCase()}</div>}
          <div class="min-w-0">
            <p class="text-[15px] font-black  truncate hover:underline">{post.author?.displayName || post.author?.handle}</p>
            <p class="text-[12px] ">@{post.author?.handle} · {timeAgo(post.createdAt)}</p>
          </div>
        </a>
      </div>
      <p class="text-[17px] leading-relaxed  whitespace-pre-wrap break-words">{post.content}</p>
      <PostActions client:load postId={post.id} likes={post.likesCount || 0} comments={post.commentsCount || 0} liked={post.liked} logged={!!viewer} />
    </article>

    <div class=" p-5">
      <CommentThread client:load postId={post.id} initial={comments} logged={!!viewer} />
    </div>
  </div>
  </Shell>
</Layout>
