---
import Layout from '../layouts/Layout.astro'
import Shell from '../components/Shell.astro'
import { hilos } from '../lib/hilos'
import { getViewer } from '../lib/session'
import FeedComposer from '../components/FeedComposer'
import FeedMore from '../components/FeedMore'
import SortBar from '../components/SortBar.astro'
import PostList from '../components/PostList.astro'

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const actingPage = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null
const feedParam = Astro.url.searchParams.get('feed')
// Inicio muestra lo relevante; la manada es cronologica y solo de quien sigues.
const scope = feedParam === 'following' && viewer ? 'following' : feedParam === 'recent' ? 'recent' : 'foryou'

// Avisos de vuelta de otros flujos (login, perfiles que ya no existen...).
const sp = Astro.url.searchParams
const notice =
  sp.get('bienvenido') === '1' ? { tone: 'ok', text: 'Tu cuenta está lista. Bienvenido a La Charca.' }
  : sp.get('auth') === 'failed' ? { tone: 'err', text: 'No pudimos completar el inicio de sesión. Inténtalo de nuevo.' }
  : sp.get('auth') === 'missing_code' ? { tone: 'err', text: 'El enlace de acceso expiró. Vuelve a entrar con CapibaraTraductor.' }
  : sp.get('perfil') === 'no_encontrado' ? { tone: 'err', text: 'Ese perfil no existe o cambió de nombre.' }
  : sp.get('post') === 'no_encontrado' ? { tone: 'err', text: 'Esa publicación ya no está disponible.' }
  : null

let posts: any[] = []
const SORTS = ['reciente', 'antiguo', 'popular', 'comentado', 'menos_popular', 'menos_comentado']
const orden = SORTS.includes(sp.get('orden') || '') ? sp.get('orden')! : 'reciente'
// El orden solo aplica a las listas cronológicas: "Lo mejor de hoy" ya trae su
// propio ranking de relevancia.
const sortable = scope !== 'foryou'
let feedData: any = null
try {
  feedData = await hilos(`/feed?limit=25&scope=${scope}&replies=1${sortable ? `&sort=${orden}` : ''}`, actingPage)
  posts = feedData?.items || []
} catch { posts = [] }

---
<Layout title="La Charca">
  <Shell viewer={viewer} active={scope === 'following' ? 'following' : 'home'}>
    {notice && (
      <p class="mb-6 text-[14px] rounded-xl px-3.5 py-2.5"
        style={notice.tone === 'ok'
          ? 'color:#05603a;background:#ecfdf3;border:1px solid #abefc6'
          : 'color:#b42318;background:#fef3f2;border:1px solid #fecdca'}>{notice.text}</p>
    )}
    {!viewer && (
      <div class="mb-10 pb-10" style="border-bottom:1px solid var(--line)">
        <p class="eyebrow mb-4">La comunidad de CapibaraTraductor</p>
        <h1 class="t-hero mb-5">Conversa sobre<br/>lo que lees.</h1>
        <p class="t-body ink-2 max-w-md">Sigue a tus scans, comenta capítulos y comparte lo que estás leyendo.</p>
        <a href="/auth/login" class="btn mt-7 inline-flex items-center gap-2">
          Continuar con CapibaraTraductor
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>
        </a>
      </div>
    )}

    {viewer && (
      <div class="flex items-center gap-2 mb-6">
        <a href="/" class={`chip ${scope === 'foryou' ? 'is-on' : ''}`}>Lo mejor de hoy</a>
        <a href="/?feed=following" class={`chip ${scope === 'following' ? 'is-on' : ''}`}>Tu manada</a>
        <a href="/?feed=recent" class={`chip ${scope === 'recent' ? 'is-on' : ''}`}>Lo más nuevo</a>
      </div>
    )}

    {viewer && <FeedComposer client:load user={viewer.user} />}

    {sortable && posts.length > 1 && <SortBar current={orden} />}

    <PostList posts={posts} viewer={viewer} empty={scope === "following" ? "Tu manada aún es pequeña. Sigue scans y lectores para llenar esta vista." : "La charca está tranquila."} />

    {feedData?.hasMore && <FeedMore client:visible scope={scope} logged={!!viewer} startPage={1} sort={sortable ? orden : undefined} />}

  </Shell>
</Layout>
