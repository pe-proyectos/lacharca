---
import Layout from '../layouts/Layout.astro'
import Shell from '../components/Shell.astro'
import PostList from '../components/PostList.astro'
import { hilos } from '../lib/hilos'
import { getViewer } from '../lib/session'
import FollowButton from '../components/FollowButton'
import { posts as postsLabel } from '../lib/format'
import PageList from '../components/PageList.astro'

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const acting = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null
const q = (Astro.url.searchParams.get('q') || '').trim()

let posts: any[] = []
let pages: any[] = []
try {
  if (q) { const d = await hilos(`/socials/search?q=${encodeURIComponent(q)}`, acting); posts = d?.items || []; pages = d?.users || [] }
  else { const d = await hilos('/feed?limit=30', acting); posts = d?.items || [] }
} catch {}
let suggested: any[] = []
try { suggested = (await hilos('/pages/suggested?limit=12', acting)) || [] } catch {}
---
<Layout title="Explorar — La Charca">
  <Shell viewer={viewer} active="explore">
    <h1 class="t-title mb-6">Explorar</h1>
    <form method="GET" class="flex items-center gap-2 mb-8 px-4 py-3 rounded-2xl max-w-2xl" style="background:#fff;border:1px solid var(--line)">
      <svg width="19" height="19" viewBox="0 0 256 256" fill="currentColor" class="ink-3 shrink-0"><path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"/></svg>
      <input name="q" value={q} placeholder="Buscar publicaciones, scans o lectores" autocomplete="off"
        class="flex-1 bg-transparent text-[16px] focus:outline-none" />
      {q && <a href="/explorar" class="t-caption hover:opacity-70 shrink-0">Limpiar</a>}
    </form>

    {!q && suggested.length > 0 && (
      <div class="mb-10">
        <div class="flex items-baseline justify-between gap-4 mb-4">
          <h2 class="t-section">Scans y lectores</h2>
          <a href="/scans" class="t-caption inline-flex items-center gap-1.5 hover:opacity-70 transition">
            Ver todos
            <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg>
          </a>
        </div>
        <div class="sm:grid sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 sm:gap-3">
          {suggested.map((s: any) => (
            <>
              <!-- Móvil: fila compacta. Escritorio: tarjeta. -->
              <div class="sm:hidden row flex items-center gap-3 py-3" style="border-bottom:1px solid var(--line)">
                <a href={`/@${s.handle}`} data-hover-handle={s.handle} class="shrink-0">
                  {s.avatarUrl
                    ? <img src={s.avatarUrl} alt="" width="46" height="46" loading="lazy" class={`object-cover ${s.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="width:46px;height:46px" />
                    : <span class={`grid place-items-center text-[15px] font-semibold ${s.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="width:46px;height:46px;background:#dbe8fb;color:var(--blue)">{(s.displayName || s.handle)[0]?.toUpperCase()}</span>}
                </a>
                <a href={`/@${s.handle}`} data-hover-handle={s.handle} class="min-w-0 flex-1">
                  <span class="block text-[15px] font-medium truncate">{s.displayName || s.handle}</span>
                  <span class="block t-caption truncate">{postsLabel(s.postsCount)}</span>
                </a>
                <FollowButton client:visible handle={s.handle} initialFollowing={s.viewerFollows} logged={!!viewer} followers={s.followersCount || 0} compact />
              </div>

              <div class="hidden sm:flex flex-col items-center text-center gap-3 p-5 rounded-2xl transition" style="border:1px solid var(--line);background:#fff">
                <a href={`/@${s.handle}`} data-hover-handle={s.handle}>
                  {s.avatarUrl
                    ? <img src={s.avatarUrl} alt="" loading="lazy" class={`w-16 h-16 object-cover ${s.type === 'user' ? 'rounded-full' : 'rounded-2xl'}`} />
                    : <span class={`grid place-items-center w-16 h-16 text-xl font-semibold ${s.type === 'user' ? 'rounded-full' : 'rounded-2xl'}`} style="background:#dbe8fb;color:var(--blue)">{(s.displayName || s.handle)[0]?.toUpperCase()}</span>}
                </a>
                <a href={`/@${s.handle}`} data-hover-handle={s.handle} class="min-w-0 w-full">
                  <span class="block text-[15px] font-semibold truncate">{s.displayName || s.handle}</span>
                  <span class="block t-caption">{postsLabel(s.postsCount)}</span>
                </a>
                <FollowButton client:visible handle={s.handle} initialFollowing={s.viewerFollows} logged={!!viewer} followers={s.followersCount || 0} />
              </div>
            </>
          ))}
        </div>
      </div>
    )}

    {q && pages.length > 0 && (
      <div class="mb-10">
        <h2 class="t-section mb-1">Cuentas</h2>
        <PageList pages={pages} viewer={viewer} />
      </div>
    )}

    <h2 class="t-section mb-2">{q ? 'Publicaciones' : 'Lo más reciente'}</h2>
    <PostList posts={posts} viewer={viewer} empty={q ? 'Sin resultados.' : 'Todavía no hay publicaciones.'} />
  </Shell>
</Layout>
