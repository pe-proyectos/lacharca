---
import Layout from '../layouts/Layout.astro'
import { hilos, timeAgo } from '../lib/hilos'
import { getViewer } from '../lib/session'
import PostActions from '../components/PostActions'

const raw = Astro.params.handle || ''
// Solo tratamos como perfil las rutas que empiezan con @
if (!raw.startsWith('@')) return Astro.redirect('/')
const handle = raw.slice(1).toLowerCase()

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const actingPage = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null

const page = await hilos(`/pages/${encodeURIComponent(handle)}`, actingPage).catch(() => null)
if (!page) return Astro.redirect('/?perfil=no_encontrado')
const wall = await hilos(`/pages/${encodeURIComponent(handle)}/posts?limit=30`, actingPage).catch(() => null)
const posts = wall?.items || []
const isScan = page.type === 'scan' || page.type === 'manga'
const isMe = viewer?.user?.handle === page.handle
---
<Layout title={`${page.displayName || '@' + page.handle} — La Charca`}>
  <div class="max-w-[640px] mx-auto border-x border-white/[0.06] min-h-screen">
    <div class="sticky top-0 z-10 backdrop-blur-xl bg-[#0a1214]/80 border-b border-white/[0.06] px-4 py-3 flex items-center gap-3">
      <a href="/" class="text-white/60 hover:text-white text-xl leading-none">←</a>
      <div class="min-w-0">
        <h1 class="text-lg font-black text-white truncate">{page.displayName || page.handle}</h1>
        <p class="text-[12px] text-white/40">{page.postsCount || 0} publicaciones</p>
      </div>
    </div>

    <div class="px-5 py-5 border-b border-white/[0.06]">
      <div class="flex items-start gap-4">
        {page.avatarUrl
          ? <img src={page.avatarUrl} alt="" class={`w-20 h-20 object-cover ring-2 ring-white/10 ${isScan ? 'rounded-2xl' : 'rounded-full'}`} />
          : <div class={`w-20 h-20 bg-teal-500/20 flex items-center justify-center text-2xl font-black text-teal-200 ${isScan ? 'rounded-2xl' : 'rounded-full'}`}>{(page.displayName || page.handle)[0]?.toUpperCase()}</div>}
        <div class="flex-1 min-w-0 pt-1">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-xl font-black text-white truncate">{page.displayName || page.handle}</h2>
            {page.type === 'scan' && <span class="text-[10px] font-black uppercase tracking-wider text-amber-400 bg-amber-400/10 rounded-full px-2 py-0.5">Scan</span>}
            {page.type === 'manga' && <span class="text-[10px] font-black uppercase tracking-wider text-teal-300 bg-teal-400/10 rounded-full px-2 py-0.5">Obra</span>}
          </div>
          <p class="text-white/45 text-sm">@{page.handle}</p>
          {page.bio && <p class="text-white/75 text-sm mt-2 whitespace-pre-wrap">{page.bio}</p>}
          <div class="flex items-center gap-4 mt-3 text-sm">
            <span class="text-white/70"><b class="text-white font-black tabular-nums">{page.followersCount || 0}</b> <span class="text-white/45">seguidores</span></span>
            <span class="text-white/70"><b class="text-white font-black tabular-nums">{page.followingCount || 0}</b> <span class="text-white/45">siguiendo</span></span>
          </div>
        </div>
      </div>
      {isMe && <p class="mt-4 text-[12px] text-teal-300/80 bg-teal-500/10 border border-teal-400/20 rounded-xl px-3 py-2">Este es tu perfil. Tu historial de CapibaraTraductor aparece aquí.</p>}
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20 px-8">
        <p class="text-5xl mb-3">🦫</p>
        <p class="text-white/60 font-bold">Sin publicaciones todavía.</p>
      </div>
    ) : (
      <div>
        {posts.map((p: any) => (
          <article class="border-b border-white/[0.06] px-4 py-3.5">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[14px] font-bold text-white">{p.author?.displayName || p.author?.handle}</span>
              <span class="text-[12px] text-white/35">· {timeAgo(p.createdAt)}</span>
            </div>
            <p class="text-[15px] leading-relaxed text-white/90 whitespace-pre-wrap break-words">{p.content}</p>
            <PostActions client:visible postId={p.id} likes={p.likesCount || 0} comments={p.commentsCount || 0} liked={p.liked} logged={!!viewer} />
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
