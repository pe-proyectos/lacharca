---
import Layout from '../layouts/Layout.astro'
import { hilos, timeAgo } from '../lib/hilos'
import { getViewer } from '../lib/session'
import PostActions from '../components/PostActions'
import Shell from '../components/Shell.astro'
import FollowButton from '../components/FollowButton'

const raw = Astro.params.handle || ''
// Solo tratamos como perfil las rutas que empiezan con @
if (!raw.startsWith('@')) return Astro.redirect('/')
const handle = raw.slice(1).toLowerCase()

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const actingPage = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null

const page = await hilos(`/pages/${encodeURIComponent(handle)}`, actingPage).catch(() => null)
if (!page) return Astro.redirect('/?perfil=no_encontrado')
const wall = await hilos(`/pages/${encodeURIComponent(handle)}/posts?limit=30`, actingPage).catch(() => null)
const posts = wall?.items || []
const isScan = page.type === 'scan' || page.type === 'manga'
const isMe = viewer?.user?.handle === page.handle
---
<Layout title={`${page.displayName || '@' + page.handle} — La Charca`}>
  <Shell viewer={viewer}>
  <div>
    <div class="card p-5 mb-4">
      <div class="flex items-start gap-4">
        {page.avatarUrl
          ? <img src={page.avatarUrl} alt="" class={`w-20 h-20 object-cover  ${isScan ? 'rounded-2xl' : 'rounded-full'}`} />
          : <div class={`w-20 h-20  flex items-center justify-center text-2xl font-black  ${isScan ? 'rounded-2xl' : 'rounded-full'}`}>{(page.displayName || page.handle)[0]?.toUpperCase()}</div>}
        <div class="flex-1 min-w-0 pt-1">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-xl font-extrabold truncate">{page.displayName || page.handle}</h2>
            {page.type === 'scan' && <span class="text-[10px] font-black uppercase tracking-wider text-amber-400 bg-amber-400/10 rounded-full px-2 py-0.5">Scan</span>}
            {page.type === 'manga' && <span class="text-[10px] font-black uppercase tracking-wider text-teal-300 bg-teal-400/10 rounded-full px-2 py-0.5">Obra</span>}
          </div>
          <p class=" text-sm">@{page.handle}</p>
          {page.bio && <p class=" text-sm mt-2 whitespace-pre-wrap">{page.bio}</p>}
          {!isMe && <div class="mt-3"><FollowButton client:load handle={page.handle} initialFollowing={page.viewerFollows} logged={!!viewer} followers={page.followersCount || 0} /></div>}
          <div class="flex items-center gap-4 mt-3 text-sm">
            <span class="ink-2"><b class=" font-black tabular-nums">{page.followersCount || 0}</b> <span class="">seguidores</span></span>
            <span class="ink-2"><b class=" font-black tabular-nums">{page.followingCount || 0}</b> <span class="">siguiendo</span></span>
          </div>
        </div>
      </div>
      {isMe && <p class="mt-4 text-[12px] rounded-xl px-3 py-2 glass" style="color:var(--aqua)">Este es tu perfil. Tu historial de CapibaraTraductor aparece aquí.</p>}
    </div>

    {posts.length === 0 ? (
      <div class="card text-center py-20 px-8">
        <p class="text-5xl mb-3">🦫</p>
        <p class="font-bold" class="ink-2">Sin publicaciones todavía.</p>
      </div>
    ) : (
      <div class="space-y-3">
        {posts.map((p: any) => (
          <article class="card card-hover p-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[14px] font-bold ">{p.author?.displayName || p.author?.handle}</span>
              <span class="text-[12px] /35">· {timeAgo(p.createdAt)}</span>
            </div>
            <p class="text-[15px] leading-relaxed whitespace-pre-wrap break-words">{p.content}</p>
            <PostActions client:visible postId={p.id} likes={p.likesCount || 0} comments={p.commentsCount || 0} liked={p.liked} logged={!!viewer} />
          </article>
        ))}
      </div>
    )}
  </div>
  </Shell>
</Layout>
