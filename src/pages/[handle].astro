---
import Layout from '../layouts/Layout.astro'
import Shell from '../components/Shell.astro'
import PostList from '../components/PostList.astro'
import FollowButton from '../components/FollowButton'
import { hilos } from '../lib/hilos'
import { getViewer } from '../lib/session'

const raw = Astro.params.handle || ''
// Solo tratamos como perfil las rutas que empiezan con @
if (!raw.startsWith('@')) return Astro.redirect('/')
const handle = raw.slice(1).toLowerCase()

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const actingPage = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null

const page = await hilos(`/pages/${encodeURIComponent(handle)}`, actingPage).catch(() => null)
if (!page) return Astro.redirect('/?perfil=no_encontrado')
const wall = await hilos(`/pages/${encodeURIComponent(handle)}/posts?limit=30`, actingPage).catch(() => null)
const posts = wall?.items || []
const isScan = page.type === 'scan' || page.type === 'manga'
const isMe = viewer?.user?.handle === page.handle
const name = page.displayName || page.handle
const n = (v: any) => Number(v || 0).toLocaleString('es')
const kind = page.type === 'scan' ? 'Scan' : page.type === 'manga' ? 'Obra' : 'Lector'
const desc = page.bio || `${kind} en La Charca. ${n(page.followersCount)} seguidores y ${n(page.postsCount)} publicaciones.`
---
<Layout title={`${name} (@${page.handle}) — La Charca`} description={desc} image={page.avatarUrl || '/logo.png'}>
  <Shell viewer={viewer}>
    <header class="pb-7 mb-2" style="border-bottom:1px solid var(--line)">
      <div class="flex items-start gap-5">
        {page.avatarUrl
          ? <img src={page.avatarUrl} alt={name} width="88" height="88" class={`w-22 h-22 object-cover shrink-0 ${isScan ? 'rounded-2xl' : 'rounded-full'}`} style="width:88px;height:88px" />
          : <span class={`grid place-items-center shrink-0 text-3xl font-semibold ${isScan ? 'rounded-2xl' : 'rounded-full'}`} style="width:88px;height:88px;background:#dbe8fb;color:var(--blue)">{name[0]?.toUpperCase()}</span>}

        <div class="flex-1 min-w-0 pt-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="t-title truncate">{name}</h1>
            {page.type === 'scan' && <span class="chip is-static">Scan</span>}
            {page.type === 'manga' && <span class="chip is-static">Obra</span>}
          </div>
          <p class="t-sub mt-0.5">@{page.handle}</p>
          {page.bio && <p class="t-body ink-2 mt-3 whitespace-pre-wrap max-w-xl">{page.bio}</p>}

          <div class="flex items-center gap-5 mt-4 text-[14px]">
            <a href={`/@${page.handle}/seguidores`} class="hover:opacity-70 transition">
              <b class="font-semibold tabular-nums">{n(page.followersCount)}</b> <span class="ink-2">seguidores</span>
            </a>
            <a href={`/@${page.handle}/siguiendo`} class="hover:opacity-70 transition">
              <b class="font-semibold tabular-nums">{n(page.followingCount)}</b> <span class="ink-2">siguiendo</span>
            </a>
            <span><b class="font-semibold tabular-nums">{n(page.postsCount)}</b> <span class="ink-2">publicaciones</span></span>
          </div>

          {!isMe && (
            <div class="mt-4">
              <FollowButton client:load handle={page.handle} initialFollowing={page.viewerFollows} logged={!!viewer} followers={page.followersCount || 0} />
            </div>
          )}
        </div>
      </div>
    </header>

    <PostList posts={posts} viewer={viewer} empty={isMe ? 'Todavía no publicaste nada. Escribe algo desde Inicio.' : 'Sin publicaciones todavía.'} />
  </Shell>
</Layout>
