---
import Layout from '../layouts/Layout.astro'
import Shell from '../components/Shell.astro'
import PostList from '../components/PostList.astro'
import FollowButton from '../components/FollowButton'
import ProfileEditor from '../components/ProfileEditor'
import MessageButton from '../components/MessageButton'
import ProfileMore from '../components/ProfileMore'
import SortBar from '../components/SortBar.astro'
import { hilos } from '../lib/hilos'
import { getViewer } from '../lib/session'
import { num, plural } from '../lib/format'

const raw = Astro.params.handle || ''
// Solo tratamos como perfil las rutas que empiezan con @
if (!raw.startsWith('@')) return Astro.redirect('/')
const handle = raw.slice(1).toLowerCase()

const viewer = await getViewer(Astro.cookies.get('lc_session')?.value)
const actingPage = viewer?.user?.id ? `external:lacharca:user:${viewer.user.id}` : null

const page = await hilos(`/pages/${encodeURIComponent(handle)}`, actingPage).catch(() => null)
if (!page) return Astro.redirect('/?perfil=no_encontrado')
const SORTS = ['reciente', 'antiguo', 'popular', 'comentado', 'menos_popular', 'menos_comentado']
const orden = SORTS.includes(Astro.url.searchParams.get('orden') || '') ? Astro.url.searchParams.get('orden')! : 'reciente'
const wall = await hilos(`/pages/${encodeURIComponent(handle)}/posts?limit=25&sort=${orden}&replies=1`, actingPage).catch(() => null)
const posts = wall?.items || []
const isScan = page.type === 'scan' || page.type === 'manga'
const isMe = viewer?.user?.handle === page.handle
const name = page.displayName || page.handle

const kind = page.type === 'scan' ? 'Scan' : page.type === 'manga' ? 'Obra' : 'Lector'
const desc = page.bio || `${kind} en La Charca. ${plural(page.followersCount, 'seguidor', 'seguidores')} y ${plural(page.postsCount, 'publicación', 'publicaciones')}.`
---
<Layout title={`${name} (@${page.handle}) — La Charca`} description={desc} image={page.avatarUrl || '/logo.png'}>
  <Shell viewer={viewer} active={isMe ? "me" : "none"}>
    <header class="pb-7 mb-2" style="border-bottom:1px solid var(--line)">
      {page.bannerUrl
        ? <img src={page.bannerUrl} alt="" class="w-full h-32 sm:h-52 object-cover rounded-2xl mb-5" />
        : <div class="w-full h-20 sm:h-32 rounded-2xl mb-5" style="background:linear-gradient(120deg,#dbe8fb,#e8f4f6)"></div>}
      <div class="flex items-start gap-4 sm:gap-5">
        {page.avatarUrl
          ? <img src={page.avatarUrl} alt={name} width="88" height="88" class={`avatar-xl object-cover shrink-0 ${isScan ? 'rounded-2xl' : 'rounded-full'}`} />
          : <span class={`avatar-xl grid place-items-center shrink-0 text-2xl sm:text-3xl font-semibold ${isScan ? 'rounded-2xl' : 'rounded-full'}`} style="background:#dbe8fb;color:var(--blue)">{name[0]?.toUpperCase()}</span>}

        <div class="flex-1 min-w-0 pt-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="t-title break-words min-w-0">{name}</h1>
            {page.type === 'scan' && <span class="chip is-static">Scan</span>}
            {page.type === 'manga' && <span class="chip is-static">Obra</span>}
          </div>
          <p class="t-sub mt-0.5">@{page.handle}</p>
          {page.bio && <p class="t-body ink-2 mt-3 whitespace-pre-wrap max-w-xl">{page.bio}</p>}

          <div class="flex items-center flex-wrap gap-x-5 gap-y-1.5 mt-4 text-[14px]">
            <a href={`/@${page.handle}/seguidores`} class="hover:opacity-70 transition">
              <b class="font-semibold tabular-nums" data-followers={page.handle} data-count={page.followersCount || 0}>{num(page.followersCount)}</b> <span class="ink-2">{Number(page.followersCount || 0) === 1 ? "seguidor" : "seguidores"}</span>
            </a>
            <a href={`/@${page.handle}/siguiendo`} class="hover:opacity-70 transition">
              <b class="font-semibold tabular-nums">{num(page.followingCount)}</b> <span class="ink-2">siguiendo</span>
            </a>
            <span><b class="font-semibold tabular-nums">{num(page.postsCount)}</b> <span class="ink-2">{Number(page.postsCount || 0) === 1 ? "publicación" : "publicaciones"}</span></span>
          </div>

          <div class="mt-4 flex items-center gap-2.5 flex-wrap">
            {isMe ? (
              <ProfileEditor client:load handle={page.handle} displayName={page.displayName || ''} bio={page.bio || ''} avatarUrl={page.avatarUrl} bannerUrl={page.bannerUrl} />
            ) : (
              <>
                <FollowButton client:load handle={page.handle} initialFollowing={page.viewerFollows} logged={!!viewer} followers={page.followersCount || 0} />
                {viewer && <MessageButton client:load handle={page.handle} canMessage={!!page.viewerFollows} />}
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    {posts.length > 1 && <SortBar current={orden} />}

    <PostList posts={posts} viewer={viewer} empty={isMe ? 'Todavía no publicaste nada. Escribe algo desde Inicio.' : 'Sin publicaciones todavía.'} />

    {wall?.hasMore && <ProfileMore client:visible handle={page.handle} logged={!!viewer} startPage={1} sort={orden} />}
  </Shell>
</Layout>
