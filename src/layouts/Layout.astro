---
import '../styles/global.css'
const { title = 'La Charca' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="La Charca — la comunidad de lectores y scans de CapibaraTraductor." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="La comunidad de lectores y scans." />
  </head>
  <body class="antialiased text-zinc-100 selection:bg-teal-400/25">
    <slot />
  </body>
</html>
