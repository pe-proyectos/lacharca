---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
const { title = 'La Charca' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="La Charca — la comunidad de lectores y scans de CapibaraTraductor." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="La comunidad de lectores y scans." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body style="font-family:'Outfit',system-ui,sans-serif">
    <slot />
  </body>
</html>
