---
// Barra superior con megamenús (CharcaNav) y, debajo, el contenido central
// protagonista con el panel de descubrimiento a la derecha. En móvil,
// CharcaNav añade la barra inferior y el menú completo.
import ChatDock from './ChatDock'
import CharcaNav from './CharcaNav'
import NavProgress from './NavProgress'
import Lightbox from './Lightbox'
import UserHoverCard from './UserHoverCard'
import SideDiscovery from './SideDiscovery.astro'
import { hilos } from '../lib/hilos'

const { viewer, active = 'home', wide = false, aside: asideMode = 'auto' } = Astro.props
// El panel derecho nunca se queda vacio: si la vista no aporta contenido
// propio, mostramos descubrimiento real (a quien seguir, que se mueve).
const hasOwnAside = Astro.slots.has('aside')
const hasAside = asideMode !== 'none'

// Temas del momento para el megamenú. Cambian despacio: se reutilizan unos
// minutos para no pedirlos en cada página.
const g = globalThis as any
if (!g.__lcTrending || Date.now() - g.__lcTrending.at > 5 * 60 * 1000) {
  try {
    const t = (await hilos('/socials/trending?limit=10')) || []
    g.__lcTrending = { at: Date.now(), tags: t.map((x: any) => x.tag).filter(Boolean) }
  } catch { g.__lcTrending = { at: Date.now(), tags: g.__lcTrending?.tags || [] } }
}
const trending: string[] = g.__lcTrending.tags

const admins = (import.meta.env.TELEMETRY_ADMINS || 'shoko').split(',').map((s: string) => s.trim().toLowerCase())
const isAdmin = !!viewer && admins.includes(String(viewer.user.handle).toLowerCase())
const navViewer = viewer ? { handle: viewer.user.handle, displayName: viewer.user.displayName, avatarUrl: viewer.user.avatarUrl } : null
---
<CharcaNav client:load active={active} viewer={navViewer} trending={trending} isAdmin={isAdmin} />

<div class="mx-auto max-w-[1400px] flex">
  <!-- CENTRO -->
  <main class="flex-1 min-w-0 px-4 sm:px-8 xl:px-10 py-6 sm:py-8 pb-[calc(84px+env(safe-area-inset-bottom))] md:pb-10"
    style={hasAside ? 'border-right:1px solid var(--line)' : ''}>
    <div class={wide ? '' : 'max-w-[900px] mx-auto'}>
      <slot />
    </div>
  </main>

  <!-- SIDEBAR DERECHA -->
  {hasAside && (
    <aside class="hidden xl:block w-[340px] shrink-0 px-7 py-8">
      <div class="sticky top-[100px] space-y-9">
        {hasOwnAside ? <slot name="aside" /> : <SideDiscovery viewer={viewer} />}
      </div>
    </aside>
  )}
</div>

<NavProgress client:idle />
<Lightbox client:idle />
{viewer && <ChatDock client:idle me={viewer.user.handle} />}
<UserHoverCard client:idle me={viewer?.user?.handle ?? null} />
