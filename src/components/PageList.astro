---
// Lista de pages (seguidores, siguiendo, resultados de busqueda).
import FollowButton from './FollowButton'
import { followers } from '../lib/format'
const { pages = [], viewer, empty = 'No hay nadie por aquí todavía.' } = Astro.props

---
{pages.length === 0 ? (
  <div class="py-24 text-center"><p class="t-body ink-2">{empty}</p></div>
) : (
  <div>
    {pages.map((p: any) => (
      <div class="row flex items-center gap-3.5 py-4" style="border-bottom:1px solid var(--line)">
        <a href={`/@${p.handle}`} data-hover-handle={p.handle} class="shrink-0">
          {p.avatarUrl
            ? <img src={p.avatarUrl} alt={p.displayName || p.handle} width="46" height="46" class={`object-cover ${p.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="width:46px;height:46px" />
            : <span class={`grid place-items-center text-[15px] font-semibold ${p.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="width:46px;height:46px;background:var(--soft);color:var(--blue)">{(p.displayName || p.handle)[0]?.toUpperCase()}</span>}
        </a>
        <a href={`/@${p.handle}`} data-hover-handle={p.handle} class="flex-1 min-w-0">
          <span class="block text-[15px] font-medium truncate">{p.displayName || p.handle}</span>
          <span class="block t-caption truncate">@{p.handle} · {followers(p.followersCount)}</span>
        </a>
        {viewer?.user?.handle !== p.handle && (
          <FollowButton client:visible handle={p.handle} initialFollowing={p.viewerFollows} logged={!!viewer} followers={p.followersCount || 0} compact />
        )}
      </div>
    ))}
  </div>
)}
