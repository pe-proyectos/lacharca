---
// Barra de ordenación para listas servidas por el servidor: cada opción es un
// enlace, así el orden elegido queda en la URL y se puede compartir.
import { useT } from '../i18n'
import cat from '../i18n/catalogos/posts'
const t = useT(cat)
const {
  current = 'reciente',
  base = '',
  param = 'orden',
  options = [
    ['reciente', t('orden_reciente')],
    ['antiguo', t('orden_antiguo')],
    ['popular', t('orden_popular')],
    ['comentado', t('orden_comentado')],
    ['menos_popular', t('orden_menos_popular')],
    ['menos_comentado', t('orden_menos_comentado')],
  ],
} = Astro.props

const href = (value: string) => {
  const url = new URL(base || Astro.url.pathname + Astro.url.search, Astro.url.origin)
  if (value === 'reciente') url.searchParams.delete(param)
  else url.searchParams.set(value === 'reciente' ? '' : param, value)
  return url.pathname + (url.search || '')
}
---
<div class="flex items-center gap-2 mb-5 overflow-x-auto pb-1" style="scrollbar-width:none">
  {options.map(([value, label]) => (
    <a href={href(value)} class={`chip shrink-0 ${current === value ? 'is-on' : ''}`}
      style="padding:6px 13px;font-size:13px;min-height:0">{label}</a>
  ))}
</div>
