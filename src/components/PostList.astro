---
import PostActions from './PostActions'
import { timeAgo } from '../lib/hilos'
const { posts = [], viewer, empty = 'Aún no hay nada por aquí.' } = Astro.props
const isMedia = (u) => /\.(png|jpe?g|gif|webp)(\?.*)?$/i.test(u) || u.includes('r2.hilos.rest')
function tokenize(c) {
  return (c || '').split(/(\s+)/).map((w) => {
    if (/^#[\p{L}\p{N}_]+$/u.test(w)) return { t: 'tag', v: w }
    if (/^@[a-zA-Z0-9_]+$/.test(w)) return { t: 'at', v: w }
    if (/^https?:\/\/\S+$/.test(w)) return { t: 'url', v: w }
    return { t: 'x', v: w }
  })
}
---
{posts.length === 0 ? (
  <div class="py-28 text-center"><p class="t-body ink-2">{empty}</p></div>
) : (
  <div>
    {posts.map((p) => {
      const imgs = (p.content || '').split(/\s+/).filter((w) => /^https?:\/\//.test(w) && isMedia(w))
      const body = (p.content || '').split('\n').filter((l) => !imgs.includes(l.trim())).join('\n')
      return (
        <article class="row py-6" style="border-bottom:1px solid var(--line)">
          <div class="flex gap-3.5">
            <a href={`/@${p.author?.handle}`} class="shrink-0">
              {p.author?.avatarUrl
                ? <img src={p.author.avatarUrl} alt="" class={`w-11 h-11 object-cover ${p.author.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} />
                : <span class={`grid place-items-center w-11 h-11 font-semibold ${p.author?.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="background:#dbe8fb;color:var(--blue)">{(p.author?.displayName || p.author?.handle || '?')[0]?.toUpperCase()}</span>}
            </a>
            <div class="min-w-0 flex-1 max-w-[760px]">
              <div class="flex items-center gap-2 flex-wrap">
                <a href={`/@${p.author?.handle}`} class="text-[16px] font-semibold hover:opacity-70 truncate">{p.author?.displayName || p.author?.handle}</a>
                {p.author?.type === 'scan' && <span class="text-[10px] font-semibold uppercase tracking-wide px-1.5 py-0.5 rounded" style="background:#e8f4f6;color:var(--aqua)">scan</span>}
                <a href={`/post/${p.id}`} class="t-caption hover:opacity-70">@{p.author?.handle} · {timeAgo(p.createdAt)}</a>
              </div>
              {body.trim() && (
                <p class="mt-1.5 t-body whitespace-pre-wrap break-words">
                  {tokenize(body).map((w) =>
                    w.t === 'tag' ? <a href={`/tag/${w.v.slice(1)}`} class="text-blue hover:opacity-70">{w.v}</a>
                    : w.t === 'at' ? <a href={`/${w.v}`} class="text-blue hover:opacity-70">{w.v}</a>
                    : w.t === 'url' ? <a href={w.v} target="_blank" rel="noopener" class="text-blue break-all hover:opacity-70">{w.v}</a>
                    : w.v)}
                </p>
              )}
              {imgs.slice(0, 4).map((u) => (
                <a href={`/post/${p.id}`} class="media block mt-3"><img src={u} alt="" loading="lazy" class="max-h-[560px] w-full object-cover" /></a>
              ))}
              <PostActions client:visible postId={p.id} likes={p.likesCount || 0} comments={p.commentsCount || 0} liked={p.liked} logged={!!viewer} />
            </div>
          </div>
        </article>
      )
    })}
  </div>
)}
