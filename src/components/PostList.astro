---
import PostActions from './PostActions'
import { timeAgo } from '../lib/hilos'
const { posts = [], viewer, empty = 'Aún no hay nada por aquí.' } = Astro.props
const isMedia = (u) => /\.(png|jpe?g|gif|webp)(\?.*)?$/i.test(u) || u.includes('r2.hilos.rest')

// Separa el texto de las imágenes de un comentario: en la vista previa se ve
// una miniatura, no un enlace kilométrico.
function splitComment(content) {
  const words = (content || '').split(/\s+/)
  const imgs = words.filter((w) => /^https?:\/\//.test(w) && isMedia(w))
  let text = (content || '')
  for (const u of imgs) text = text.replace(u, '')
  return { text: text.replace(/\s+/g, ' ').trim(), imgs }
}
function tokenize(c) {
  return (c || '').split(/(\s+)/).map((w) => {
    if (/^#[\p{L}\p{N}_]+$/u.test(w)) return { t: 'tag', v: w }
    if (/^@[a-zA-Z0-9_]+$/.test(w)) return { t: 'at', v: w }
    if (/^https?:\/\/\S+$/.test(w)) return { t: 'url', v: w }
    return { t: 'x', v: w }
  })
}
---
{posts.length === 0 ? (
  <div class="py-28 text-center"><p class="t-body ink-2">{empty}</p></div>
) : (
  <div>
    {posts.map((p) => {
      const imgs = (p.content || '').split(/\s+/).filter((w) => /^https?:\/\//.test(w) && isMedia(w))
      const body = (p.content || '').split('\n').filter((l) => !imgs.includes(l.trim())).join('\n')
      return (
        <article class="row py-6" style="border-bottom:1px solid var(--line)">
          <div class="flex gap-3.5">
            <a href={`/@${p.author?.handle}`} data-hover-handle={p.author?.handle} class="shrink-0">
              {p.author?.avatarUrl
                ? <img src={p.author.avatarUrl} alt="" class={`w-11 h-11 object-cover ${p.author.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} />
                : <span class={`grid place-items-center w-11 h-11 font-semibold ${p.author?.type === 'user' ? 'rounded-full' : 'rounded-xl'}`} style="background:var(--soft);color:var(--blue)">{(p.author?.displayName || p.author?.handle || '?')[0]?.toUpperCase()}</span>}
            </a>
            <div class="min-w-0 flex-1 max-w-[760px]">
              <div class="flex items-center gap-2 flex-wrap">
                <a href={`/@${p.author?.handle}`} data-hover-handle={p.author?.handle} class="text-[16px] font-semibold hover:opacity-70 truncate">{p.author?.displayName || p.author?.handle}</a>
                {p.author?.type === 'scan' && <span class="text-[10px] font-semibold uppercase tracking-wide px-1.5 py-0.5 rounded" style="background:var(--soft-aqua);color:var(--aqua)">scan</span>}
                <a href={`/post/${p.id}`} class="t-caption hover:opacity-70">@{p.author?.handle} · {timeAgo(p.createdAt)}</a>
              </div>
              {body.trim() && (
                <p class="mt-1.5 t-body whitespace-pre-wrap break-words">
                  {tokenize(body).map((w) =>
                    w.t === 'tag' ? <a href={`/tag/${w.v.slice(1)}`} class="text-blue hover:opacity-70">{w.v}</a>
                    : w.t === 'at' ? <a href={`/${w.v}`} class="text-blue hover:opacity-70">{w.v}</a>
                    : w.t === 'url' ? <a href={w.v} target="_blank" rel="noopener" class="text-blue break-all hover:opacity-70">{w.v}</a>
                    : w.v)}
                </p>
              )}
              {p.wall && p.wall.type === 'manga' && (
                <a href={p.wall.parentHandle ? `/@${p.wall.parentHandle}/${p.wall.handle}` : `/@${p.wall.handle}`} data-hover-handle={p.wall.handle}
                  class="mt-2.5 flex items-center gap-3 p-2.5 rounded-2xl transition hover:opacity-85"
                  style="border:1px solid var(--line);background:var(--surface)">
                  {p.wall.avatarUrl
                    ? <img src={p.wall.avatarUrl} alt="" width="44" height="44" loading="lazy" class="rounded-xl object-cover shrink-0" style="width:44px;height:44px" />
                    : <span class="grid place-items-center rounded-xl text-[15px] font-semibold shrink-0" style="width:44px;height:44px;background:var(--soft);color:var(--blue)">{(p.wall.displayName || p.wall.handle)[0]?.toUpperCase()}</span>}
                  <span class="min-w-0">
                    <span class="block eyebrow">Obra</span>
                    <span class="block text-[14px] font-medium truncate">{p.wall.displayName || p.wall.handle}</span>
                  </span>
                </a>
              )}

              {imgs.length > 0 && (
                <div class={`mt-3 grid gap-2 ${imgs.length > 1 ? 'grid-cols-2' : ''}`}>
                  {imgs.slice(0, 4).map((u) => (
                    <span class={`media post-media ${imgs.length > 1 ? 'post-media--grid' : ''}`}
                      style={`--media-bg:url('${u}')`}
                      data-lightbox data-lightbox-group={`post-${p.id}`} data-src={u}>
                      <img src={u} alt="Imagen de la publicación" loading="lazy" />
                    </span>
                  ))}
                </div>
              )}
              <PostActions client:visible postId={p.id} likes={p.likesCount || 0} comments={p.commentsCount || 0} liked={p.liked} saved={p.saved} logged={!!viewer} />

              {p.recentComments && p.recentComments.length > 0 && (
                <div class="mt-3 pl-3.5 space-y-2.5" style="border-left:2px solid var(--line)">
                  {p.recentComments.slice(0, 4).map((c: any) => (
                    <div class="flex items-start gap-2">
                      <a href={`/@${c.author?.handle}`} data-hover-handle={c.author?.handle} class="shrink-0 mt-0.5">
                        {c.author?.avatarUrl
                          ? <img src={c.author.avatarUrl} alt="" width="22" height="22" class="rounded-full object-cover" style="width:22px;height:22px" />
                          : <span class="grid place-items-center rounded-full text-[10px] font-semibold" style="width:22px;height:22px;background:var(--soft);color:var(--blue)">{(c.author?.displayName || c.author?.handle || '?')[0]?.toUpperCase()}</span>}
                      </a>
                      <p class="t-sub min-w-0 flex-1">
                        <a href={`/@${c.author?.handle}`} data-hover-handle={c.author?.handle} class="font-medium hover:opacity-70 mr-1.5" style="color:var(--ink)">{c.author?.displayName || c.author?.handle}</a>
                        {splitComment(c.content).text && (
                          <span class="ink-2">
                            {splitComment(c.content).text.length > 120 ? `${splitComment(c.content).text.slice(0, 120)}…` : splitComment(c.content).text}
                          </span>
                        )}
                        {c.likesCount > 0 && (
                          <span class="t-caption ml-1.5 inline-flex items-center gap-0.5 align-middle" title={`${c.likesCount} me gusta`}>
                            <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40Z"/></svg>
                            {c.likesCount}
                          </span>
                        )}
                        {splitComment(c.content).imgs.slice(0, 3).map((u) => (
                          <a href={`/post/${p.id}`} class="inline-block align-middle ml-1.5 media" style="border-radius:8px">
                            <img src={u} alt="Imagen del comentario" loading="lazy" width="34" height="34"
                              style="width:34px;height:34px;object-fit:cover;display:block" />
                          </a>
                        ))}
                      </p>
                    </div>
                  ))}
                  {p.commentsCount > p.recentComments.length && (
                    <a href={`/post/${p.id}`} class="t-caption inline-flex items-center gap-1 hover:opacity-70 transition">
                      Ver las {Number(p.commentsCount).toLocaleString('es')} respuestas
                      <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </article>
      )
    })}
  </div>
)}
